# Odoo 14 Docker Environment — Copy to .env and customize. DO NOT commit .env.
# ============================================================

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_DB=postgres
# PostgreSQL is exposed on host port 5433 (not 5432, avoids conflicts)

# ── Development ────────────────────────────────────────────
# Set to 1 to enable --dev=all (auto-reload, debug assets, detailed errors)
DEV_MODE=0

# Set to 1 to enable debugpy on port 5678 (waits for IDE to attach before starting)
# Also uncomment the "5678:5678" port in your docker-compose.{project}.yml
ENABLE_DEBUGGER=0

# ── Optional Entrypoint Features ─────────────────────────
# Wait for PostgreSQL to be ready before starting Odoo (opt-in, max 30s)
# WAIT_FOR_DB=1

# Override Odoo log level (debug, info, warn, error, critical)
# LOG_LEVEL=info

# Pass arbitrary extra CLI args to Odoo (e.g., --no-database-list, --test-enable)
# ODOO_EXTRA_ARGS=

# ── Docker Hub Image ───────────────────────────────────────
# Pull this version's image: docker pull alakosha/odoo-image:14.0
# Or run /init-docker-container — it handles everything automatically.
