# Odoo 16 Docker Environment
# Copy to .env and customize. DO NOT commit .env.

# --- PostgreSQL ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_DB=postgres
# PostgreSQL exposed on host port 5433 (not 5432)

# --- Development ---
# Set to 1 for --dev=all (auto-reload, debug assets)
DEV_MODE=0

# Set to 1 for debugpy on port 5678 (waits for IDE to attach)
ENABLE_DEBUGGER=0
