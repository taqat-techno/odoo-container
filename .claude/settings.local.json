{
  "permissions": {
    "allow": [
      "Read",
      "Bash",
      "WebSearch",
      "WebFetch",
      "Bash(docker *)",
      "Bash(docker-compose *)"
    ],
    "deny": [
      "Edit(odoo/**)",
      "Write(odoo/**)"
    ],
    "ask": [
      "Bash(touch:*)",
      "Bash(New-Item:*)",
      "Bash(ni :*)"
    ]
  }
}
